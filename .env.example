# Copy to .env and fill in real values; docker compose reads this file automatically.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_HOST_ADDRESS=https://your-domain.example
TELEGRAM_SECRET_TOKEN=your_secret_token_here

# Seq logging (optional). SEQ_URL is the address used by the app inside the compose network.
SEQ_URL=http://seq:5341
# Set a password (min 8 chars) to protect the Seq UI; leave empty for anonymous access.
SEQ_ADMIN_PASSWORD=
