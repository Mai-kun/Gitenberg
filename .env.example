# Copy to .env and fill in real values; docker compose reads this file automatically.

# Public share links (optional). Base URL used to build /share/{token} links
# shown to users; when empty, the address of the incoming request is used.
# SHARING_PUBLIC_BASE_URL=https://your-domain.example

# Web sign-in sessions (optional overrides).
# WEBAUTH__SESSIONLIFETIMEDAYS=30

# Seq logging (optional). SEQ_URL is the address used by the app inside the compose network.
SEQ_URL=http://seq:5341
# Set a password (min 8 chars) to protect the Seq UI; leave empty for anonymous access.
SEQ_ADMIN_PASSWORD=
# Disable Seq authentication (true by default). Set to false if SEQ_ADMIN_PASSWORD is provided.
SEQ_NO_AUTHENTICATION=true
